    "gsap": "^3.14.2",
    "lenis": "^1.3.17",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vercel/node": "^24.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
