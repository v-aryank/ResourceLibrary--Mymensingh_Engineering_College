{
  "name": "red-brick-college-landing-page",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host localhost --port 5173 --strictPort",
    "vercel": "node scripts/vercel-dev.mjs",
